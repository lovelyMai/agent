{
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "newlinesBetween": false,
    "groups": [
      "value-builtin",
      "value-external",
      "type-external",
      { "newlinesBetween": true },
      "types",
      "utils",
      "services",
      { "newlinesBetween": true },
      "modules",
      { "newlinesBetween": true },
      "unknown"
    ],
    "customGroups": [
      {
        "groupName": "types",
        "elementNamePattern": ["**/types", "**/types/**"]
      },
      {
        "groupName": "utils",
        "elementNamePattern": ["**/utils", "**/utils/**"]
      },
      {
        "groupName": "services",
        "elementNamePattern": ["**/services", "**/services/**"]
      },
      {
        "groupName": "modules",
        "elementNamePattern": ["**/modules", "**/modules/**"]
      }
    ]
  }
}
