{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "strict": true,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": ["**/*.ts", "config.js"],
  "exclude": [
    "node_modules",
    "dist",
  ]
}