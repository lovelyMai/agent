{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitAny": false,
    "allowJs": true,
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    },
  },
  "include": ["**/*.ts","**/*.js"],
  "exclude": ["dist"]
}
